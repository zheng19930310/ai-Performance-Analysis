  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, group, stream) (rate(newapi_llm_requests_total{model=~\"$model\",group=~\"$group\",stream=~\"$stream\",channel_id=~\"$channel_id\"}[5m]))",
          "legendFormat": "{{model}} / {{group}} / stream={{stream}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Success rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(newapi_llm_requests_total{model=~\"$model\",group=~\"$group\",stream=~\"$stream\",channel_id=~\"$channel_id\",outcome=\"success\"}[5m])) / clamp_min(sum(rate(newapi_llm_requests_total{model=~\"$model\",group=~\"$group\",stream=~\"$stream\",channel_id=~\"$channel_id\"}[5m])), 0.000001)",
          "legendFormat": "Success rate",
          "range": true
        }
      ]
    },
    {
      "id": 3,
